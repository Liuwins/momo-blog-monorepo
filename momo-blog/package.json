{
  "name": "momo-blog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rimraf dist node_modules/.vite node_modules/.cache && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.vue",
    "format": "prettier --write src",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.11",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.33.0",
    "happy-dom": "^20.11.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "axios": "^1.17.0",
    "dayjs": "^1.11.21",
    "dompurify": "^3.4.13",
    "marked": "^18.0.9",
    "pinia": "^3.0.4",
    "socket.io-client": "^4.8.3",
    "unplugin-vue-components": "^32.1.0",
    "vant": "^4.9.24",
    "vite-plugin-style-import": "^2.0.0",
    "vue": "^3.5.38",
    "vue-router": "^4.6.4"
  },
  "overrides": {
    "js-beautify": {
      "glob": "10.5.0"
    },
    "nanoid": "3.3.18"
  }
}
