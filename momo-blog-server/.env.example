NODE_ENV=development
PORT=3001

# SQLite 数据库路径（better-sqlite3）
DB_PATH=./data/momoblog.db

# JWT 密钥（必须配置，至少 16 字符，生产环境请用强随机密钥）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=please_change_this_to_a_strong_random_secret_key

# 前端地址（CORS 白名单）
CLIENT_ORIGIN=http://localhost:5175

# 对外站点根地址（Open Graph 分享链接使用；生产环境必须配置）
SITE_URL=http://localhost:5175

# 文件上传目录（Windows 用绝对路径，如 D:/momo-blog/images）
UPLOAD_DIR=./images

# Compose 前端宿主机映射（生产默认 0.0.0.0:80；本地完整链路可使用 127.0.0.1:39080）
FRONTEND_HOST_BIND=0.0.0.0
FRONTEND_HOST_PORT=80
