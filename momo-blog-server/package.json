{
  "name": "momo-blog-server",
  "version": "1.0.0",
  "description": "MomoBlog NestJS backend",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:queries": "node scripts/query-benchmark.js",
    "media:report": "node scripts/media-report.js",
    "typecheck": "tsc --noEmit",
    "migration:run": "typeorm migration:run -d dist/data-source.js",
    "migration:generate": "typeorm migration:generate -d dist/data-source.js src/migrations/Init"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/platform-socket.io": "^11.2.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.2.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dompurify": "^3.4.13",
    "helmet": "^8.3.0",
    "nest-winston": "^1.10.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.0",
    "typeorm": "^0.3.20",
    "uuid": "^11.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "lodash": "4.18.1",
    "multer": "2.2.0",
    "qs": "6.15.3",
    "@nestjs/common": {
      "file-type": "21.3.4"
    },
    "@nestjs/typeorm": {
      "uuid": "11.1.1"
    }
  }
}
